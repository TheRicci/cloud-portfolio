#!/usr/bin/env bash
# Pull the pinned commit and apply the hardening playbook once.
# Appends one line per run to /var/log/hardening/runs.log:
#   <start> <end> exit=<code> changed=<n>
set -euo pipefail

CONF=/etc/hardening/pull.env
# shellcheck source=/dev/null
. "$CONF"

LOG_DIR=/var/log/hardening
RUN_LOG="$LOG_DIR/runs.log"
CHECKOUT=/var/lib/hardening/checkout
mkdir -p "$LOG_DIR" /var/lib/hardening

# One run at a time: the timer and a manual run must not overlap.
exec 9>/run/lock/hardening-pull.lock
flock -w 600 9

export ANSIBLE_COLLECTIONS_PATH=/usr/local/share/ansible/collections
export ANSIBLE_NOCOLOR=1
export ANSIBLE_FORCE_COLOR=0

out="$(mktemp)"
start="$(date -u +%FT%TZ)"
status=0
ansible-pull \
  --url "$REPO_URL" \
  --checkout "$REPO_SHA" \
  --directory "$CHECKOUT" \
  --inventory localhost, \
  "$PROJECT_DIR/ansible/local.yml" >"$out" 2>&1 || status=$?

changed="$(sed -n 's/^localhost[[:space:]]*:[[:space:]]*ok=[0-9]*[[:space:]]*changed=\([0-9]*\).*/\1/p' "$out" | tail -1)"
echo "$start $(date -u +%FT%TZ) exit=$status changed=${changed:-unknown}" >>"$RUN_LOG"

cat "$out"
rm -f "$out"
exit "$status"
