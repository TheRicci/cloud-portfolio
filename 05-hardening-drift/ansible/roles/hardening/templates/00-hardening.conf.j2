# Managed by Ansible. Manual changes are reverted on the next run.
# This file is named 00- so it wins over 50-cloud-init.conf: sshd keeps the
# first value it reads for each keyword.
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
PermitEmptyPasswords no
X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no
MaxAuthTries {{ hardening_ssh_max_auth_tries }}
LoginGraceTime 30
ClientAliveInterval 300
ClientAliveCountMax 2
Banner {{ hardening_ssh_banner }}
AllowUsers {{ hardening_allowed_login_users | join(' ') }}
KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
