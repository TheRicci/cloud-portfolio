# Copy this file to /etc/observability/runtime.env on the workload VM (mode 0600, root-owned).
# Do not commit the populated file or pass these values through Terraform.
# SMTP_USERNAME and SMTP_PASSWORD come from AWS SES > SMTP settings > Create SMTP credentials.
SMTP_SMARTHOST=email-smtp.us-east-1.amazonaws.com:587
SMTP_FROM=you@example.com
SMTP_USERNAME=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
ALERT_EMAIL=you@example.com
