# Copy to /etc/observability/monitoring.env on the monitoring VM (mode 0600).
# Do not commit populated credentials or pass them through Terraform.
# GF_SMTP_USER and GF_SMTP_PASSWORD come from AWS SES > SMTP settings > Create SMTP credentials.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
GF_SMTP_ENABLED=true
GF_SMTP_HOST=email-smtp.us-east-1.amazonaws.com:587
GF_SMTP_USER=REPLACE_ME
GF_SMTP_PASSWORD=REPLACE_ME
GF_SMTP_FROM_ADDRESS=you@example.com
GF_SMTP_FROM_NAME="Portfolio monitoring"
GRAFANA_ALERT_EMAIL=you@example.com
