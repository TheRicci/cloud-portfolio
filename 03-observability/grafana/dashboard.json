{
  "__inputs": [],
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data (check the telemetry pipeline)"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{cloud=~\"$cloud\"}[2m]))",
          "refId": "A"
        }
      ],
      "title": "Request rate",
      "repeat": "cloud",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data (check the telemetry pipeline)"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{cloud=~\"$cloud\",code_class=\"5xx\"}[2m])) / sum(rate(http_requests_total{cloud=~\"$cloud\"}[2m]))",
          "refId": "A"
        }
      ],
      "title": "Error percentage",
      "repeat": "cloud",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data (check the telemetry pipeline)"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{cloud=~\"$cloud\"}[2m])))",
          "refId": "A"
        }
      ],
      "title": "p95 latency",
      "repeat": "cloud",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data (check the telemetry pipeline)"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "expr": "up{job=\"service\",cloud=~\"$cloud\"}",
          "refId": "A"
        }
      ],
      "title": "Service up",
      "repeat": "cloud",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No data (check the telemetry pipeline)"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "id": 5,
      "targets": [
        {
          "expr": "100 - avg by (cloud) (rate(node_cpu_seconds_total{cloud=~\"$cloud\",mode=\"idle\"}[2m])) * 100",
          "refId": "A"
        }
      ],
      "title": "Host CPU",
      "repeat": "cloud",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No data (check the telemetry pipeline)"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "id": 6,
      "targets": [
        {
          "expr": "(1 - node_memory_MemAvailable_bytes{cloud=~\"$cloud\"} / node_memory_MemTotal_bytes{cloud=~\"$cloud\"}) * 100",
          "refId": "A"
        }
      ],
      "title": "Host memory used",
      "repeat": "cloud",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data (check the telemetry pipeline)"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "id": 7,
      "targets": [
        {
          "expr": "time() - max by (cloud) (max_over_time(timestamp(up{job=\"service\",cloud=~\"$cloud\"})[24h:]))",
          "refId": "A"
        }
      ],
      "title": "Age of newest sample",
      "repeat": "cloud",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 8,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showCommonLabels": false,
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{container=\"obs-service\", cloud=~\"$cloud\"} |= \"work request failed\"",
          "refId": "A"
        }
      ],
      "title": "Recent service error logs",
      "type": "logs"
    }
  ],
  "schemaVersion": 41,
  "tags": [
    "portfolio",
    "observability"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": [
            "aws",
            "azure"
          ],
          "value": [
            "aws",
            "azure"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(up{job=\"service\"}, cloud)",
        "includeAll": true,
        "multi": true,
        "name": "cloud",
        "query": {
          "query": "label_values(up{job=\"service\"}, cloud)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "title": "AWS and Azure service observability",
  "uid": "portfolio-observability",
  "version": 1
}

