{
  "apiVersion": 1,
  "groups": [
    {
      "name": "observability-no-data",
      "folder": "Cloud Portfolio",
      "interval": "1m",
      "rules": [
        {
          "uid": "portfolio-observability-no-data",
          "title": "No data from a VM",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": {
                "from": 120,
                "to": 0
              },
              "datasourceUid": "REPLACE_PROMETHEUS_DATASOURCE_UID",
              "model": {
                "expr": "time() - max by (cloud) (max_over_time(timestamp(up{job=\"service\"})[24h:]))",
                "instant": true,
                "range": false,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "queryType": "",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        120
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "refId": "B"
              }
            }
          ],
          "for": "1m",
          "noDataState": "Alerting",
          "execErrState": "Error",
          "annotations": {
            "summary": "A cloud has stopped sending service samples.",
            "description": "A VM's newest service sample is more than two minutes old. Check Alloy and outbound connectivity first."
          },
          "labels": {
            "severity": "warning"
          }
        }
      ]
    }
  ]
}

